-- A/B overlap decode (same binary) --
# baseline
./slorado basecaller -C 128 -K 2048 -o output_fast_1k_base.fastq models/dna_r10.4.1_e8.2_400bps_fast@v5.0.0 test/PGXXXX230339/reads_1k.blow5

# overlap 1k fast
make clean; make -j5 cuda=1 jetson=1 zstd=1 cxx11_abi=1 LIBTORCH_DIR=$TORCH_PATH;./slorado basecaller --overlap-decode=yes -C 128 -o output_fast_1k_overlap.fastq models/dna_r10.4.1_e8.2_400bps_fast@v5.0.0 test/PGXXXX230339/reads_1k.blow5

# compare
diff <(grep -v '^@\|^+' output_fast_1k_base.fastq | awk 'NR%2==1') <(grep -v '^@\|^+' output_fast_1k_overlap.fastq | awk 'NR%2==1') | head

