  "run_limits": {
    "stall_s": 900,
    "cap_factor": 2.5,
    "floor_rate_samples_per_s": {
      "fast": 3000000,
      "hac": 800000
    },
    "min_cap_s": 180,
    "attempts": 2
  },
  "gate": {
    "tj_C": 55.0,
    "timeout_s": 300
  },
  "power": {
    "hz": 20,
    "pre_shoulder_s": 3.0,
    "post_shoulder_s": 4.0,
    "idle_s": 60
  },
  "canary_python": "~/slorado_venv/bin/python3",
  "worktree_root": "~/bench-stages",
  "worktrees": {
    "upstream": {
      "commit": "754a74d",
      "note": "unmodified upstream BonsonW/slorado main (true original)"
    },
    "paper": {
      "commit": "406ab8c",
      "note": "commit the Slorado/Openfish preprint used on the Jetson AGX Xavier (Table S7); ancestor of 754a74d"
    },
    "pre_overlap": {
      "commit": "8873209",
      "note": "start of the optimisation work, before overlap decode"
    },
    "overlap": {
      "commit": "7cec6c5",
      "note": "overlap decode v1.2"
    },
    "loadimb": {
      "commit": "65246f2",
      "note": "narrow batches + flush threshold"
    },
    "spec": {
      "commit": "49ac641",
      "note": "speculative decode (re-created greedy draft)"
    },
    "cpubeam": {
      "commit": "664bb1f",
      "note": "CPU beam hybrid experiment (dead end)"
    }
  },
  "stage_order": [
    "upstream",
    "ov_off",
    "ov_on",
    "lb_baseline",
    "lb_best",
    "spec",
    "cb_off",
    "cb_on",
    "paper_xavier"
  ],
  "rna_stages": [
    "upstream",
    "ov_on",
    "lb_best",
    "spec"
  ],
  "stages": {
    "upstream": {
      "worktree": "upstream",
      "args": [],
      "model_args": {}
    },
    "paper_xavier": {
      "worktree": "paper",
      "flags": [
        "-t",
        "8",
        "-B",
        "500M",
        "-K",
        "2000",
        "-c",
        "10000",
        "-C",
        "200"
      ],
      "args": [],
      "model_args": {},
      "default_cells": [
        "dna_fast_500k"
      ],
      "note": "Table S7 command line (Jetson AGX Xavier, FAST, HG002-dna-500k); use with mode B and the 500k dataset for the cross-device comparison"
    },
    "pre_overlap": {
      "worktree": "pre_overlap",
      "args": [],
      "model_args": {},
      "invalid": "Decodes garbage: at 8873209 slorado transposes the model output to TNC but the pinned openfish (3d95491) reads NTC, so batches >1 are scrambled (smoke test 2026-10-22: 0/1000 reads match upstream on DNA and RNA, ~30% sequence similarity). Fixed from v1.0 (e00bada). Use 'upstream' (754a74d) as the pre-overlap baseline."
    },
    "ov_off": {
      "worktree": "overlap",
      "args": [
        "--overlap-decode=no"
      ],
      "model_args": {}
    },
    "ov_on": {
      "worktree": "overlap",
      "args": [
        "--overlap-decode=yes"
      ],
      "model_args": {}
    },
    "lb_baseline": {
      "worktree": "loadimb",
      "args": [
        "--overlap-decode=yes",
        "--fixed-c-batch=yes"
      ],
      "model_args": {}
    },
    "lb_best": {
      "worktree": "loadimb",
      "args": [
        "--overlap-decode=yes",
        "--fixed-c-batch=no"
      ],
      "model_args": {
        "fast": [
          "--flush-threshold=64"
        ],
        "hac": [
          "--flush-threshold=128"
        ]
      }
    },
    "spec": {
      "worktree": "spec",
      "args": [
        "--overlap-decode=yes",
        "--fixed-c-batch=no",
        "--speculative-decode=yes",
        "--spec-repair-threshold=10",
        "--spec-margin-threshold=2",
        "--spec-overlap-repair=yes"
      ],
      "model_args": {
        "fast": [
          "--flush-threshold=64"
        ],
        "hac": [
          "--flush-threshold=128"
        ]
      }
    },
    "cb_off": {
      "worktree": "cpubeam",
      "args": [
        "--cpu-beam=no"
      ],
      "model_args": {}
    },
    "cb_on": {
      "worktree": "cpubeam",
      "args": [
        "--cpu-beam=yes"
      ],
      "model_args": {}
    }
  }
}