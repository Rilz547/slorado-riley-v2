{
  "_comment": "Final-campaign configuration. Cell id = <dtype>_<model>_<size>, e.g. dna_fast_1k, rna_hac_20k, dna_fast_500k (a two-part id such as fast_1k means DNA). Every stage runs with shared_flags unless the stage gives its own 'flags' (paper_xavier); extra 'args' / per-model 'model_args' are appended. 'upstream' uses the shared flags too (the June upstream baselines used -C 256 for FAST and wrote a FASTQ; they are reported separately as legacy data).",
  "shared_flags": [
    "-C",
    "128",
    "-c",
    "12288",
    "-K",
    "4096",
    "-p",
    "150"
  ],
  "models": {
    "dna": {
      "fast": "models/dna_r10.4.1_e8.2_400bps_fast@v5.0.0",
      "hac": "models/dna_r10.4.1_e8.2_400bps_hac@v5.0.0"
    },
    "rna": {
      "fast": "models/rna004_130bps_fast@v5.1.0",
      "hac": "models/rna004_130bps_hac@v5.1.0"
    }
  },
  "references": {
